<?xml version="1.0" encoding="utf-8"?>
<!-- BotHub often runs at home: plain http is allowed (the app warns), https everywhere else. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
